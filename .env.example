NEXT_PUBLIC_FER_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_FER_INTERVAL_MS=1000
NEXT_PUBLIC_FER_TIMEOUT_MS=10000

# Legacy diagnostic condition; sesi LMS memakai kondisi dari urutan di pengaturan.
AUI_EXPERIMENT_CONDITION=ADAPTIVE
# true menyembunyikan seluruh debug/simulasi juga pada pnpm dev.
AUI_RESEARCH_MODE=false

# Password pengaturan penelitian. Wajib diisi juga untuk development/TEST.
RESEARCHER_KEY=
# Optional absolute path outside public; default .research-data in this project.
RESEARCH_DATA_DIR=
# Optional legacy MAIN override. Leave blank when using approval in research-allocation.json.
RESEARCH_MAIN_PROFILE=
